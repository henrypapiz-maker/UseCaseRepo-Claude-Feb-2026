# ============================================================
# Environment Variables for Claude Code MCP Integrations
# ============================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control.
# ============================================================

# --- Claude Code Model ---
# Sets the default model for Claude Code sessions
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# --- GitHub ---
# Personal Access Token with 'repo' scope
# Generate at: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Vercel ---
# OAuth handled automatically via browser on first use.
# If using the community vercel-mcp package instead, uncomment:
# VERCEL_API_KEY=

# --- Neon (Postgres) ---
# OAuth handled automatically via browser on first use.
# If using the stdio transport instead, uncomment:
# NEON_API_KEY=
